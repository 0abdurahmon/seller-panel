    "/products/{id}/stock": {
      "patch": {
        "description": "Rules are in docs/DECISIONS.md (D5).\n- `stock` is the new absolute quantity (0–1 000 000), so a retried request gives the same result.\n- `expected_stock` is the stock the seller saw; if it changed meanwhile, nothing is written (409 `stock_changed`).\n- `stock` cannot go below `reserved` (409 `stock_below_reserved`); archived products are refused (409 `product_archived`).\n- A product of another shop returns 404, the same as a missing one.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockLevel"
                }
              }
            },
            "description": "The new stock level"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "code": "stock_changed",
                  "message": "stock was changed since you opened it; reload and try again"
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`stock_changed` (reload the product and try again), `stock_below_reserved` or `product_archived`.\n"
          }
        },
        "summary": "Set the stock of a product from the product list",
        "tags": [
          "Stock"
        ]
      }
    },
