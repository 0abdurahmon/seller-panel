{
  "components": {
    "parameters": {
      "OrderId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "Page": {
        "in": "query",
        "name": "page",
        "required": false,
        "schema": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "PageSize": {
        "in": "query",
        "name": "page_size",
        "required": false,
        "schema": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "ProductId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Business rule violated: `invalid_transition`, `insufficient_stock`, or `product_not_found`\n(a product of the order no longer exists).\n"
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Not found, or not owned by the current shop"
      },
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Rate limit reached (`rate_limited`), retry after the number of seconds in `Retry-After`",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait",
            "schema": {
              "type": "integer"
            }
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Missing or invalid token"
      },
      "ValidationError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Invalid request body (for example, missing `reason` on cancel)"
      }
    },
    "schemas": {
      "Balance": {
        "properties": {
          "available": {
            "description": "Sum of all balance entries, so'm",
            "type": "integer"
          },
          "commission": {
            "description": "Sum of `commission` entries (negative), so'm",
            "type": "integer"
          },
          "earned": {
            "description": "Sum of `sale` entries, so'm",
            "type": "integer"
          }
        },
        "required": [
          "available",
          "earned",
          "commission"
        ],
        "type": "object"
      },
      "BalanceEntry": {
        "properties": {
          "amount": {
            "description": "Signed amount in so'm (sale \u003e 0, commission \u003c= 0, payout \u003c 0)",
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "order_id": {
            "description": "The order the money belongs to; null for a payout",
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "type": {
            "enum": [
              "sale",
              "commission",
              "payout"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "order_id",
          "type",
          "amount",
          "created_at"
        ],
        "type": "object"
      },
      "BalanceEntryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BalanceEntry"
            },
            "type": "array"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "type": "object"
      },
      "Category": {
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "description": "Null for a top-level category, two levels in total",
            "format": "int64",
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "parent_id"
        ],
        "type": "object"
      },
      "CategoryList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "CreateProductRequest": {
        "additionalProperties": false,
        "properties": {
          "category_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "description": {
            "maxLength": 5000,
            "type": "string"
          },
          "price": {
            "description": "so'm",
            "format": "int64",
            "maximum": 1000000000000,
            "minimum": 1,
            "type": "integer"
          },
          "sku": {
            "description": "Unique within the shop",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "default": "draft",
            "enum": [
              "draft",
              "active"
            ],
            "type": "string"
          },
          "stock": {
            "default": 0,
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "category_id",
          "title",
          "price",
          "sku"
        ],
        "type": "object"
      },
      "DashboardSummary": {
        "properties": {
          "revenue_30d": {
            "description": "Sum of delivered order totals in the last 30 days, so'm",
            "type": "integer"
          },
          "revenue_7d": {
            "description": "Sum of delivered order totals in the last 7 days, so'm",
            "type": "integer"
          },
          "today_orders": {
            "description": "Orders created today",
            "type": "integer"
          },
          "top_products": {
            "items": {
              "$ref": "#/components/schemas/TopProduct"
            },
            "maxItems": 5,
            "type": "array"
          },
          "waiting_for_action": {
            "description": "Orders the seller still has to act on, in status `new`, `accepted` or `packed`",
            "type": "integer"
          }
        },
        "required": [
          "today_orders",
          "waiting_for_action",
          "revenue_7d",
          "revenue_30d",
          "top_products"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "example": "invalid_transition",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "Order": {
        "properties": {
          "buyer_name": {
            "type": "string"
          },
          "buyer_phone": {
            "type": "string"
          },
          "cancel_reason": {
            "nullable": true,
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "delivery_address": {
            "type": "string"
          },
          "history": {
            "description": "Every status change, oldest first. An order created by the dev endpoint starts with one row\nfrom `null` to `new`; orders that were inserted some other way can have no rows yet.\n",
            "items": {
              "$ref": "#/components/schemas/OrderHistoryEntry"
            },
            "type": "array"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array"
          },
          "number": {
            "example": "#100245",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "status_changed_at": {
            "format": "date-time",
            "type": "string"
          },
          "total": {
            "description": "Sum of price × quantity in so'm",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "number",
          "status",
          "buyer_name",
          "buyer_phone",
          "delivery_address",
          "items",
          "total",
          "created_at",
          "status_changed_at",
          "history"
        ],
        "type": "object"
      },
      "OrderHistoryEntry": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "from_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrderStatus"
              }
            ],
            "nullable": true
          },
          "reason": {
            "description": "The cancel reason, null for other changes",
            "nullable": true,
            "type": "string"
          },
          "to_status": {
            "$ref": "#/components/schemas/OrderStatus"
          }
        },
        "required": [
          "from_status",
          "to_status",
          "reason",
          "created_at"
        ],
        "type": "object"
      },
      "OrderItem": {
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "price": {
            "description": "Unit price snapshot in so'm",
            "type": "integer"
          },
          "product_id": {
            "format": "int64",
            "type": "integer"
          },
          "quantity": {
            "minimum": 1,
            "type": "integer"
          },
          "title": {
            "description": "Title snapshot taken at order time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "product_id",
          "title",
          "price",
          "quantity"
        ],
        "type": "object"
      },
      "OrderPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            },
            "type": "array"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "type": "object"
      },
      "OrderStatus": {
        "enum": [
          "new",
          "accepted",
          "packed",
          "handed_to_courier",
          "delivered",
          "cancelled"
        ],
        "type": "string"
      },
      "OrderSummary": {
        "description": "Order without items, used in lists",
        "properties": {
          "buyer_name": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "number": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "number",
          "status",
          "buyer_name",
          "total",
          "created_at"
        ],
        "type": "object"
      },
      "Product": {
        "properties": {
          "available": {
            "description": "stock minus reserved",
            "type": "integer"
          },
          "category_id": {
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "price": {
            "description": "so'm",
            "format": "int64",
            "type": "integer"
          },
          "reserved": {
            "type": "integer"
          },
          "shop_id": {
            "format": "int64",
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          },
          "stock": {
            "type": "integer"
          },
          "stock_label": {
            "$ref": "#/components/schemas/StockLabel"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "shop_id",
          "category_id",
          "title",
          "description",
          "price",
          "sku",
          "stock",
          "reserved",
          "available",
          "stock_label",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ProductPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "type": "object"
      },
      "ProductStatus": {
        "enum": [
          "draft",
          "active",
          "archived"
        ],
        "type": "string"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "description": "At most 72 bytes, bcrypt ignores the rest",
            "maxLength": 72,
            "minLength": 8,
            "type": "string"
          },
          "shop_name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "shop_name"
        ],
        "type": "object"
      },
      "Shop": {
        "properties": {
          "contact_phone": {
            "example": "+998901234567",
            "nullable": true,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "logo_url": {
            "maxLength": 2048,
            "nullable": true,
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "type": "string"
          },
          "pickup_address": {
            "maxLength": 300,
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "type": "object"
      },
      "ShopUpdate": {
        "properties": {
          "contact_phone": {
            "description": "7–15 digits with an optional leading +. Spaces, dashes and brackets are removed. Empty clears it.",
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "logo_url": {
            "description": "http or https URL. Empty clears it.",
            "maxLength": 2048,
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "pickup_address": {
            "maxLength": 300,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "StockLabel": {
        "description": "`out_of_stock` when available is 0, `low_stock` when 0 \u003c available ≤ LOW_STOCK_THRESHOLD (default 5),\n`in_stock` otherwise.\n",
        "enum": [
          "in_stock",
          "low_stock",
          "out_of_stock"
        ],
        "type": "string"
      },
      "StockLevel": {
        "example": {
          "available": 4,
          "product_id": 1,
          "reserved": 3,
          "stock": 7,
          "stock_label": "low_stock",
          "updated_at": "2026-11-23T18:55:34Z"
        },
        "properties": {
          "available": {
            "description": "stock − reserved",
            "type": "integer"
          },
          "product_id": {
            "format": "int64",
            "type": "integer"
          },
          "reserved": {
            "description": "Units promised to accepted orders",
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          },
          "stock_label": {
            "$ref": "#/components/schemas/StockLabel"
          },
          "updated_at": {
            "description": "UTC",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "stock",
          "reserved",
          "available",
          "stock_label",
          "updated_at"
        ],
        "type": "object"
      },
      "StockUpdateRequest": {
        "additionalProperties": false,
        "example": {
          "expected_stock": 10,
          "stock": 12
        },
        "properties": {
          "expected_stock": {
            "description": "The stock the seller saw before editing",
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          },
          "stock": {
            "description": "New absolute stock",
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "stock",
          "expected_stock"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "token": {
            "description": "HS256 JWT carrying seller_id and shop_id, sent as `Authorization Bearer`",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expires_at"
        ],
        "type": "object"
      },
      "TopProduct": {
        "properties": {
          "product_id": {
            "format": "int64",
            "type": "integer"
          },
          "quantity_sold": {
            "description": "Units in delivered orders in the last 30 days",
            "type": "integer"
          },
          "revenue": {
            "description": "so'm",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "title",
          "quantity_sold",
          "revenue"
        ],
        "type": "object"
      },
      "TransitionRequest": {
        "properties": {
          "reason": {
            "description": "Required when `to` is `cancelled`",
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "$ref": "#/components/schemas/OrderStatus"
          }
        },
        "required": [
          "to"
        ],
        "type": "object"
      },
      "UpdateProductRequest": {
        "additionalProperties": false,
        "properties": {
          "category_id": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "description": {
            "maxLength": 5000,
            "type": "string"
          },
          "price": {
            "format": "int64",
            "maximum": 1000000000000,
            "minimum": 1,
            "type": "integer"
          },
          "sku": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "description": "Kept as is when omitted",
            "enum": [
              "draft",
              "active"
            ],
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "category_id",
          "title",
          "price",
          "sku"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Seller Panel API: sellers sign up with email and password, manage their shop and products,\nprocess orders, see their balance, and (planned) see the dashboard.\n\n**Auth.** `POST /auth/register` or `POST /auth/login` returns a JWT. Send it as\n`Authorization: Bearer \u003ctoken\u003e`. Every other endpoint needs it, and a seller only ever sees\nthe data of their own shop.\n\n**Conventions.**\n- JSON with `snake_case` fields. Ids are integers. Money is an integer in so'm, never a float.\n- Errors are `{\"code\": \"...\", \"message\": \"...\"}`, also for unknown routes (`404 not_found`)\n  and wrong methods (`405 method_not_allowed`, with an `Allow` header).\n- Lists take `page` and `page_size` (default 20) and return `items`, `page`, `page_size`, `total`.\n  A `page_size` above 100 is lowered to 100 and a `page` below 1 becomes 1; a value that is not an integer is a 400.\n- An optional value that is not set is `null` when its column can be null (for example `logo_url`),\n  and `\"\"` for text that always has a value (for example a product `description`).\n- Any endpoint can answer `429 rate_limited` with a `Retry-After` header (seconds): per IP at the proxy,\n  per shop on protected routes, and 5 failed logins per IP and email in 15 minutes.\n\n**Status.** Implemented: auth, shop, categories, products, stock, balance, orders.\n`POST /dev/simulate-order` exists only when the backend runs with `APP_ENV=development` (the Docker\nCompose default); otherwise it answers 404 like any unknown route.\nPlanned (it answers 404 until built): dashboard.\n",
    "title": "Seller Panel API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Token for the seller"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Wrong email or password (`invalid_credentials`)"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [],
        "summary": "Log in with email and password and return a token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
