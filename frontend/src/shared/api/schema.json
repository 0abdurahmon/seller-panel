    "/orders/{id}/transition": {
      "post": {
        "description": "Runs in one transaction: either the status and every side effect change, or nothing does.\nAllowed transitions follow the status machine in docs/DOMAIN.md:\n`new → accepted → packed → handed_to_courier → delivered`, and `cancelled`\nfrom `new`, `accepted` or `packed`.\n- `accepted` reserves stock (fails with 409 `insufficient_stock` if available \u003c quantity).\n- `cancelled` releases reserved stock and requires `reason`.\n- `delivered` deducts stock and writes `sale` and `commission` balance entries.\nAny other transition is rejected with 409 `invalid_transition`.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "description": "The order after the transition"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "summary": "Move an order to the next status",
        "tags": [
          "Orders"
        ]
      }
    },
