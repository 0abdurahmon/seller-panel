map $uri $auth_limit_key {
  default "";
  ~^/api/auth/ $binary_remote_addr;
}

limit_req_zone $binary_remote_addr zone=api_global:10m rate=${RATE_LIMIT_NGINX_API_RATE};
limit_req_zone $auth_limit_key zone=api_auth:10m rate=${RATE_LIMIT_NGINX_AUTH_RATE};
limit_req_zone $binary_remote_addr zone=api_files:10m rate=${RATE_LIMIT_NGINX_FILES_RATE};
limit_req_status 429;
limit_req_log_level warn;

server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  # A product with 5 photos of 5 MB each; the backend enforces the real limit of every route.
  client_max_body_size 27m;

  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  error_page 429 = @rate_limited;

  location @rate_limited {
    default_type application/json;
    add_header Retry-After "10" always;
    include /etc/nginx/snippets/security-headers.conf;
    return 429 '{"code":"rate_limited","message":"too many requests, try again later"}';
  }

  location ~ "^/api/uploads/(?<shop>[0-9]+)/(?<file>[0-9a-f]{32}\.webp)$" {
    limit_req zone=api_files burst=${RATE_LIMIT_NGINX_FILES_BURST} nodelay;
    alias /srv/uploads/$shop/$file;
    default_type image/webp;
    access_log off;
    error_page 404 = @file_not_found;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'" always;
  }

  location /api/uploads/ {
    default_type application/json;
    return 404 '{"code":"not_found","message":"file not found"}';
  }

  location @file_not_found {
    default_type application/json;
    return 404 '{"code":"not_found","message":"file not found"}';
  }

  # Server-sent events: no buffering, and a read timeout well above the 25 s heartbeat.
  location = /api/orders/events {
    limit_req zone=api_global burst=${RATE_LIMIT_NGINX_API_BURST} nodelay;
    proxy_pass http://backend:8080/orders/events;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    gzip off;
    include /etc/nginx/snippets/security-headers.conf;
  }

  location /api/ {
    limit_req zone=api_global burst=${RATE_LIMIT_NGINX_API_BURST} nodelay;
    limit_req zone=api_auth burst=${RATE_LIMIT_NGINX_AUTH_BURST} nodelay;
    proxy_pass http://backend:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    include /etc/nginx/snippets/security-headers.conf;
  }

  location = /docs {
    absolute_redirect off;
    return 301 /docs/;
  }

  location = /swagger {
    include /etc/nginx/snippets/spec-proxy.conf;
  }

  location = /docs/spec/openapi.json {
    include /etc/nginx/snippets/spec-proxy.conf;
  }

  location /docs/ {
    index index.html;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ =404;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri /index.html;
  }
}
