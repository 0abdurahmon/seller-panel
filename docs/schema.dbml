Project seller_panel {
  database_type: 'PostgreSQL'
  Note: '''
    Seller Panel database schema. Paste this file into https://dbdiagram.io/d to see the diagram.
    Documentation only: the source of truth is backend/migrations, explained in docs/DATA_MODEL.md.
    Not expressible in DBML: partial index orders_shop_delivered_idx (WHERE status = 'delivered'),
    DESC sort direction of some indexes, and the pg_trgm GIN indexes on products.title and products.sku.
  '''
}

Enum product_status {
  draft
  active
  archived
}

Enum order_status {
  new
  accepted
  packed
  handed_to_courier
  delivered
  cancelled
}

Enum balance_entry_type {
  sale [note: 'amount > 0']
  commission [note: 'amount <= 0']
  payout [note: 'amount < 0, has no order']
}

Table sellers {
  id bigint [pk, increment]
  email text [not null, unique, note: 'stored lower-case']
  password_hash text [not null, note: 'bcrypt']
  created_at timestamptz [not null, default: `now()`]

  checks {
    `email = lower(email) AND email <> ''` [name: 'sellers_email_check']
  }
}

Table shops {
  id bigint [pk, increment]
  seller_id bigint [not null, unique, note: 'exactly one shop per seller']
  name text [not null]
  logo_url text
  description text [not null, default: '']
  contact_phone text
  pickup_address text
  created_at timestamptz [not null, default: `now()`]

  checks {
    `btrim(name) <> ''` [name: 'shops_name_check']
  }
}

Table categories {
  id bigint [pk, increment]
  name text [not null]
  parent_id bigint [note: 'null for top level, two levels are enough']

  indexes {
    parent_id [name: 'categories_parent_idx']
    (`COALESCE(parent_id, 0)`, name) [unique, name: 'categories_parent_name_key']
  }

  checks {
    `btrim(name) <> ''` [name: 'categories_name_check']
  }

  Note: 'Seeded by a migration, read only for sellers.'
}

Table products {
  id bigint [pk, increment]
  shop_id bigint [not null]
  category_id bigint [not null]
  title text [not null, note: 'service limit: 1-200 characters']
  description text [not null, default: '', note: 'service limit: up to 5000 characters']
  price bigint [not null, note: 'integer UZS, service limit: 1 to 1 000 000 000 000']
  sku text [not null, note: 'service limit: 1-64 characters']
  stock integer [not null, default: 0, note: 'units physically owned, service limit: up to 1 000 000']
  reserved integer [not null, default: 0, note: 'units promised to accepted orders']
  status product_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, sku) [unique, name: 'products_shop_sku_key']
    (shop_id, status, created_at) [name: 'products_shop_status_created_idx']
    (shop_id, category_id) [name: 'products_shop_category_idx']
  }

  checks {
    `btrim(title) <> ''` [name: 'products_title_check']
    `btrim(sku) <> ''` [name: 'products_sku_check']
    `price > 0` [name: 'products_price_check']
    `stock >= 0` [name: 'products_stock_check']
    `reserved >= 0` [name: 'products_reserved_check']
    `reserved <= stock` [name: 'products_reserved_within_stock']
  }

  Note: 'available = stock - reserved (derived, not stored).'
}

Table product_photos {
  id bigint [pk, increment]
  product_id bigint [not null, note: 'ON DELETE CASCADE']
  url text [not null]
  position integer [not null, note: '0 is the cover photo']

  indexes {
    (product_id, position) [unique, name: 'product_photos_position_key']
  }

  checks {
    `url <> ''` [name: 'product_photos_url_check']
    `position >= 0` [name: 'product_photos_position_check']
  }
}

Table orders {
  id bigint [pk, increment]
  shop_id bigint [not null]
  number bigint [not null, unique, default: `nextval('order_number_seq')`, note: 'sequence starts at 100000, shown as #100245']
  status order_status [not null, default: 'new']
  buyer_name text [not null]
  buyer_phone text [not null]
  delivery_address text [not null]
  total bigint [not null, note: 'integer UZS, fixed at creation']
  cancel_reason text [note: 'required exactly when status is cancelled']
  created_at timestamptz [not null, default: `now()`]
  status_changed_at timestamptz [not null, default: `now()`]

  indexes {
    (shop_id, status, created_at) [name: 'orders_shop_status_created_idx']
    (shop_id, created_at) [name: 'orders_shop_created_idx']
    (shop_id, status_changed_at) [name: 'orders_shop_delivered_idx']
  }

  checks {
    `btrim(buyer_name) <> ''` [name: 'orders_buyer_name_check']
    `btrim(buyer_phone) <> ''` [name: 'orders_buyer_phone_check']
    `btrim(delivery_address) <> ''` [name: 'orders_delivery_address_check']
    `total > 0` [name: 'orders_total_check']
    `(status = 'cancelled' AND cancel_reason IS NOT NULL AND btrim(cancel_reason) <> '') OR (status <> 'cancelled' AND cancel_reason IS NULL)` [name: 'orders_cancel_reason_matches_status']
  }
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null, note: 'products are archived, never deleted']
  title_snapshot text [not null, note: 'copied from the product at order time']
  price_snapshot bigint [not null, note: 'copied from the product at order time']
  quantity integer [not null]

  indexes {
    (order_id, product_id) [unique, name: 'order_items_order_product_key']
    product_id [name: 'order_items_product_idx']
  }

  checks {
    `price_snapshot > 0` [name: 'order_items_price_check']
    `quantity > 0` [name: 'order_items_quantity_check']
  }
}

Table order_status_history {
  id bigint [pk, increment]
  order_id bigint [not null]
  from_status order_status [note: 'null for the creation row']
  to_status order_status [not null]
  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, created_at) [name: 'order_status_history_order_idx']
  }
}

Table balance_entries {
  id bigint [pk, increment]
  shop_id bigint [not null]
  order_id bigint [note: 'null only for payouts']
  type balance_entry_type [not null]
  amount bigint [not null, note: 'signed integer UZS']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (order_id, type) [unique, name: 'balance_entries_order_type_key']
    (shop_id, created_at) [name: 'balance_entries_shop_created_idx']
  }

  checks {
    `(type = 'sale' AND amount > 0) OR (type = 'commission' AND amount <= 0) OR (type = 'payout' AND amount < 0)` [name: 'balance_entries_sign']
    `(type = 'payout') = (order_id IS NULL)` [name: 'balance_entries_order_matches_type']
  }

  Note: 'Append only. Balance = sum(amount) per shop. One sale and one commission entry per order.'
}

Ref: shops.seller_id - sellers.id
Ref: categories.parent_id > categories.id
Ref: products.shop_id > shops.id
Ref: products.category_id > categories.id
Ref: product_photos.product_id > products.id [delete: cascade]
Ref: orders.shop_id > shops.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: order_status_history.order_id > orders.id
Ref: balance_entries.shop_id > shops.id
Ref: balance_entries.order_id > orders.id
